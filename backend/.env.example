# 复制为 .env 后填写；全部留空时系统自动走降级链，不会报错。

# LLM 仅用于 extract_jd 与解释填槽（DeepSeek / 通义等 OpenAI 兼容端点）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 高德开放平台 Web 服务 Key（地图 POI 证据源）
AMAP_API_KEY=

# OCR：auto = 装有 rapidocr 就启用；disabled = 明确关闭
OCR_ENGINE=auto
# Windows 若 onnxruntime 报 MSVCP140_1.dll 缺失，可指定运行库目录
# MSVC_DLL_DIR=D:\path\to\backend\vendor\msvc
